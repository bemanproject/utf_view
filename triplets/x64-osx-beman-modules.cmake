# SPDX-License-Identifier: BSL-1.0

set(VCPKG_TARGET_ARCHITECTURE x64)
set(VCPKG_CRT_LINKAGE dynamic)
set(VCPKG_LIBRARY_LINKAGE static)

set(VCPKG_CMAKE_SYSTEM_NAME Darwin)
set(VCPKG_OSX_ARCHITECTURES x86_64)

if(PORT STREQUAL "beman-utf-view")
    list(APPEND VCPKG_CMAKE_CONFIGURE_OPTIONS "-DBEMAN_UTF_VIEW_USE_MODULES=ON")
elseif(PORT STREQUAL "beman-transform-view")
    list(
        APPEND VCPKG_CMAKE_CONFIGURE_OPTIONS
        "-DBEMAN_TRANSFORM_VIEW_USE_MODULES=ON"
    )
endif()
